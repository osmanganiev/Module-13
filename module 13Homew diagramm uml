@startuml
left to right direction
skinparam packageStyle rectangle

actor "Читатель" as reader
actor "Библиотекарь" as librarian
actor "Администратор" as admin

' Наследование ролей
librarian -up-|> reader : <<extends>>
admin -up-|> librarian : <<extends>>

rectangle "Система управления сетью библиотек" {

  ' Читатель
  reader --> (Регистрация в системе)
  reader --> (Просмотр доступных книг)
  reader --> (Поиск книг)
  reader --> (Бронирование книги)
  reader --> (Отмена бронирования)
  reader --> (Просмотр истории бронирований)

  ' Библиотекарь
  librarian --> (Добавление книги)
  librarian --> (Удаление книги)
  librarian --> (Выдача книги)
  librarian --> (Возврат книги)
  librarian --> (Просмотр активных бронирований)

  ' Администратор
  admin --> (Управление филиалами)
  admin --> (Управление пользователями)
  admin --> (Просмотр аналитики)

  ' Связи include / extends
  (Поиск книг) .> (Просмотр доступных книг) : <<include>>
  (Бронирование книги) .> (Просмотр доступных книг) : <<include>>
  (Выдача книги) .> (Просмотр активных бронирований) : <<include>>
  (Управление пользователями) .> (Регистрация в системе) : <<include>>
  (Просмотр аналитики) .> (Просмотр активных бронирований) : <<include>>

}

note right of admin
  Администратор может выполнять
  все действия библиотекаря
  и читателя
end note

@enduml
