@startuml
left to right direction

actor Гость
actor "Зарегистрированный пользователь" as user
actor Администратор

user -up-|> Гость
Администратор -up-|> user

rectangle "Система бронирования мероприятий" {

  Гость --> (Просмотр мероприятий)

  user --> (Бронирование мероприятия)
  user --> (Отмена бронирования)

  Администратор --> (Управление мероприятиями)
  Администратор --> (Просмотр всех бронирований)

  (Бронирование мероприятия) .> (Просмотр мероприятий) : <<include>>
  (Управление мероприятиями) .> (Просмотр мероприятий) : <<include>>

}
@enduml
